# GebeyaLink API configuration — template.
#
# Copy this file to `.env` and replace every value. The API reads `.env` automatically
# (`apps/api/core/config.py`), and `.env` is ignored by git: this template is the only
# configuration file that is ever committed.
#
# The values below are placeholders. They are deliberately unreal — a deployment that
# starts with them unchanged is a deployment with no secrets, which is worse than one that
# fails to start. Nothing here is a credential, and nothing here should be used as one.
#
# Required settings have no default and are uncommented; optional settings show the default
# they would take when omitted. Every name matches the setting it feeds, so a value set here
# reads the same as one injected into a container's environment.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. The API applies no default and refuses to start without one.
DATABASE_URL=postgresql+psycopg://gebeyalink:replace-me@localhost:5432/gebeyalink

# Redis connection string. Holds verification codes and live sessions.
REDIS_URL=redis://localhost:6379/0

# Signing material, asymmetric. The API signs with the private half and verifies with the
# public half; the two below are obvious non-keys, not a pair. Generate a real one with
# `openssl genpkey` (private) and `openssl pkey -pubout` (public), and inject it as PEM.
SIGNING_PRIVATE_KEY=replace-me-with-a-pem-encoded-private-key
SIGNING_PUBLIC_KEY=replace-me-with-a-pem-encoded-public-key

# Shared secret the SMS gateway signs its inbound callbacks with. Required, no default: a
# deployment that forgot it would otherwise check every callback against a value in source.
GATEWAY_SECRET=replace-me-with-a-shared-gateway-secret

# Version stamped on every terms acceptance recorded from now on.
TERMS_VERSION=2026-01-01

# ── Optional, with the default shown ────────────────────────────────────────

# Identifier stamped into issued tokens so a rotated key can be told apart.
SIGNING_KEY_ID=primary

# Token lifetimes, in seconds. Fifteen minutes and thirty days.
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# Verification codes: six digits, valid for five minutes, five wrong guesses tolerated, one
# per number per minute, five per number per day.
OTP_CODE_DIGITS=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_SEND_LIMIT_PER_PHONE=5

# Abuse controls, keyed by the caller's address: ten requests per minute to the sign-in and
# code endpoints, twenty codes triggered per day, across all numbers.
AUTH_ENDPOINT_LIMIT_PER_MINUTE_PER_IP=10
OTP_DAILY_SEND_LIMIT_PER_IP=20

# Which SMS backend to build. Only `recording` exists so far; the real gateway arrives with
# the provider credentials.
SMS_PROVIDER=recording

# Which side funds the platform fee and its VAT: BUYER, SELLER or SPLIT_50. The buyer pays by
# default.
FEE_PAYER=BUYER

# Which payment modes checkout may create. Both are off until a deployment decides otherwise,
# exactly like the pilot flows they gate. The flags gate a mode's existence, not its
# arithmetic: a COD order above its ceiling is still refused with the mode switched on.
COD_ENABLED=false
ESCROW_ENABLED=false

# The percentage of ordered kilos a delivered order may fall short by before a buyer's
# confirmation of delivery is refused (FR-2507).
TRANSIT_SHRINKAGE_TOLERANCE_PCT=2.0

# Serve /docs, /redoc and /openapi.json. Off unless something asks for it; the security scan
# in CI is the one caller that sets it.
EXPOSE_DOCS=false
